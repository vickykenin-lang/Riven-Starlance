RIVEN_AWS_REGION=ap-south-1

# Fill these only after actual Bedrock model access is verified in the target account/region.
RIVEN_MODEL_MAIN=
RIVEN_MODEL_RESEARCHER_1=
RIVEN_MODEL_RESEARCHER_2=
RIVEN_MODEL_RESEARCHER_3=
RIVEN_MODEL_RESEARCHER_4=

# Phase 6.1 web research.
# Recommended: multi (Researcher 1/3 prefer Tavily; Researcher 2/4 prefer Exa; automatic fallback).
# Supported: disabled | multi | tavily | exa | brave
RIVEN_WEB_SEARCH_PROVIDER=disabled

RIVEN_TAVILY_API_KEY=
RIVEN_TAVILY_ENDPOINT=https://api.tavily.com/search

RIVEN_EXA_API_KEY=
RIVEN_EXA_ENDPOINT=https://api.exa.ai/search

# Optional legacy/third provider.
RIVEN_BRAVE_API_KEY=
RIVEN_WEB_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
